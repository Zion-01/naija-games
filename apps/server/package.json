{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/index.ts",
    "start": "node --import tsx --env-file-if-exists=.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load": "tsx load/run.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/ws-transport": "^0.18.4",
    "@naija/engine": "workspace:*",
    "@naija/online": "workspace:*",
    "jose": "^6.2.12",
    "tsx": "^4.23.15"
  }
}
